<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard: Anexar Foto -->
    <record id="os_fotos_wizard_view" model="ir.ui.view">
        <field name="name">os.fotos.wizard.form</field>
        <field name="model">os.fotos.wizard</field>
        <field name="arch" type="xml">
            <form string="Anexar Fotos por Setor" class="o_form_view o_form_nosheet">
                <group>
                    <field name="setor" string="Setor"/>
                    <field name="attachment_ids" widget="many2many_binary" string="Selecionar Arquivos"/>
                </group>
                <footer>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    <button name="action_anexar" type="object" string="Anexar" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="os_fotos_wizard_action" model="ir.actions.act_window">
        <field name="name">Anexar Fotos por Setor</field>
        <field name="res_model">os.fotos.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Herança da view da OS: aba Foto com grupos por setor -->
    <record id="ordem_servico_form_inherit_photos" model="ir.ui.view">
        <field name="name">ordem.servico.form.inherit.photos</field>
        <field name="model">ordem.servico</field>
        <field name="inherit_id" ref="ordem_servico.ordem_servico_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='Fotos']" position="replace">
                <page string="Fotos" name="Fotos">
                    <group string="Fotos por Setor">
                        <group string="Produção">

                            <field name="fotos_producao" widget="os_fotos_preview" nolabel="1"/>
                        </group>
                        <group string="Acabamento">

                            <field name="fotos_acabamento" widget="os_fotos_preview" nolabel="1"/>
                        </group>
                        <group string="Inspeção">

                            <field name="fotos_inspecao" widget="os_fotos_preview" nolabel="1"/>
                        </group>
                        <group string="Embalagem">

                            <field name="fotos_embalagem" widget="os_fotos_preview" nolabel="1"/>
                        </group>
                        <group string="Entrega">

                            <field name="fotos_entrega" widget="os_fotos_preview" nolabel="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
